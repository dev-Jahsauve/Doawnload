# --- API / worker ---
PORT=4000
REDIS_URL=redis://localhost:6379
CORS_ORIGIN=http://localhost:3000
DOWNLOAD_PROVIDER=ytdlp
YTDLP_PATH=yt-dlp
WORKER_CONCURRENCY=2
DOWNLOADS_DIR=./downloads
LOG_LEVEL=info

# --- Limitation par IP ---
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_SECONDS=3600

# --- Régie publicitaire (Adsterra) : clés issues de ton tableau de bord ---
# Sans clé, les emplacements restent vides et le mode prioritaire est quand même actif.
NEXT_PUBLIC_ADSTERRA_BANNER_KEY=
NEXT_PUBLIC_ADSTERRA_PRIORITY_KEY=

# --- Extracteur HTTP (mode serverless / Vercel) ---
# EXTRACT_PROVIDER : "cobalt" (instance compatible Cobalt) ou "rapidapi" (endpoint JSON classique)
# Laisse vide pour le mode VPS complet (worker yt-dlp + Redis) : l'app proxifie alors vers API_ORIGIN.
# Option A (instance Cobalt auto-hebergee) : voir infra/cobalt/README.md
#   1. deploie l'image ghcr.io/imputnet/cobalt:11 (Railway 1-clic :
#      https://railway.com/deploy/cobalt-tools--cobalt-tools), variable API_URL = ton URL publique + "/"
#   2. remplis EXTRACT_PROVIDER=cobalt et EXTRACT_API_URL=https://<ton-instance>/
EXTRACT_PROVIDER=
EXTRACT_API_URL=
# Service yt-dlp de secours, compatible Cobalt (ex. Facebook, qui exige une
# session pour etre accessible depuis une IP de datacenter).
# Deploiement 1-clic : render.yaml a la racine (Render -> New + -> Blueprint).
# Supporte les cookies via COOKIES_PATH (Secret File Render, format cookies.txt).
EXTRACT_FALLBACK_URL=
# Optionnel : UUID de la cle si ton instance est protegee par API_KEY_URL (voir infra/cobalt/keys.json.example).
# Format : Authorization: Api-Key <uuid> — envoye automatiquement.
EXTRACT_API_KEY=
# Laisse vide pour Cobalt. (RapidAPI custom) nom d'en-tete si l'API n'utilise pas x-rapidapi-key.
EXTRACT_API_HEADER=

# --- Rate limit partage (Upstash Redis REST, recommande sur Vercel) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Tableau de bord administrateur (/admin) ---
# Mot de passe qui protege la page https://<ton-site>/admin
# Il n'appartient a aucun compte externe : choisis-en un dedie et garde-le secret.
ADMIN_PASSWORD=

# --- Frontend (build Docker) ---
API_ORIGIN=http://server:4000
