# --- API / worker ---
PORT=4000
REDIS_URL=redis://localhost:6379
CORS_ORIGIN=http://localhost:3000
DOWNLOAD_PROVIDER=ytdlp
YTDLP_PATH=yt-dlp
WORKER_CONCURRENCY=2
DOWNLOADS_DIR=./downloads
LOG_LEVEL=info

# --- Limitation par IP ---
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_SECONDS=3600

# --- Régie publicitaire (Adsterra) : clés issues de ton tableau de bord ---
# Sans clé, les emplacements restent vides et le mode prioritaire est quand même actif.
NEXT_PUBLIC_ADSTERRA_BANNER_KEY=
NEXT_PUBLIC_ADSTERRA_PRIORITY_KEY=

# --- Frontend (build Docker) ---
API_ORIGIN=http://server:4000
